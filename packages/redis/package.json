{
	"name": "@org/redis",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		"./package.json": "./package.json",
		".": {
			"@org/source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"nx": {
		"targets": {
			"build": {
				"executor": "@nx/esbuild:esbuild",
				"outputs": [
					"{options.outputPath}"
				],
				"options": {
					"outputPath": "packages/redis/dist",
					"main": "packages/redis/src/index.ts",
					"tsConfig": "packages/redis/tsconfig.lib.json",
					"format": [
						"esm"
					],
					"bundle": true,
					"thirdParty": false,
					"declarationRootDir": "packages/redis/src"
				}
			}
		}
	},
	"dependencies": {
		"redis": "^5.10.0"
	}
}
